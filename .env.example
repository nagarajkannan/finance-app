DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Sign-in with Google (Google Cloud console → APIs & Services → Credentials → OAuth client ID → Web application)
# Production client: authorized redirect https://your-app.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local `next dev` client: authorized redirect http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID_DEV=""
GOOGLE_CLIENT_SECRET_DEV=""

# Long random string used to sign the session and PIN cookies: openssl rand -base64 48
AUTH_SECRET=""

# Public URL of the deployment, used to build the Google redirect URI.
# Production (Render): https://your-app.onrender.com
APP_URL=""
# Local development
APP_URL_DEV="http://localhost:3000"

# Optional: comma separated Google accounts allowed to sign in. Empty means anyone with a Google account.
ALLOWED_EMAILS=""
